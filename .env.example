# Copy to .env and fill in. .env is gitignored.

# Shared Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://hack:hack@localhost:5432/hack

# HuggingFace cache (optional — share between components to save disk)
HF_HOME=~/.cache/huggingface

# Local LLM endpoint — canonical: nemotron-3-super via Ollama on the GB10 (:11434/v1).
# A vLLM FP8 OpenAI-compatible endpoint is a supported stricter-JSON fallback (swap the
# URL/model below). All inference is local; no external API is called.
LLM_BASE_URL=http://gx10-f470.taildb985c.ts.net:11434/v1
LLM_API_KEY=local
LLM_MODEL=nemotron-3-super:latest

# Embedding model. vote-predictor uses the Ollama-served nomic-embed-text (768-dim) for
# similar-case retrieval; other components may use a local sentence-transformer instead.
EMBEDDING_MODEL=nomic-embed-text:latest

# Connector port (UI looks for this)
CONNECTOR_PORT=8000

# UI → Connector
NEXT_PUBLIC_CONNECTOR_URL=http://localhost:8000

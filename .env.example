# Copy to .env and fill in. .env is gitignored.

# Shared Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://hack:hack@localhost:5432/hack

# HuggingFace cache (optional — share between components to save disk)
HF_HOME=~/.cache/huggingface

# Local LLM endpoint (vLLM or text-generation-webui)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embedding model (defaults to a local sentence-transformer)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Connector port (UI looks for this)
CONNECTOR_PORT=8000

# UI → Connector
NEXT_PUBLIC_CONNECTOR_URL=http://localhost:8000
